# Configuration de Production - NE PAS COMMITER CE FICHIER !
# Copier ce fichier en .env et remplir les valeurs

# Django Settings
SECRET_KEY=your-very-long-and-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database (PostgreSQL recommandé pour la production)
DATABASE_URL=postgres://user:password@host:port/dbname

# Pour Railway:
# DATABASE_URL sera automatiquement configuré

# Pour Render:
# DATABASE_URL sera automatiquement configuré depuis render.yaml

# Pour Heroku:
# DATABASE_URL sera automatiquement configuré avec l'addon PostgreSQL

# Email Configuration (Optionnel)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Ndeyas Shop <noreply@ndeyasshop.com>

# Media Files (pour production, utiliser un service cloud)
# AWS S3 (recommandé)
USE_S3=False
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=ndeyas-shop-media
AWS_S3_REGION_NAME=us-east-1

# Ou Cloudinary (alternative gratuite)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payment Gateway (Optionnel)
# Stripe
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx

# PayPal
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_MODE=live  # 'sandbox' pour les tests

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# Monitoring (Optionnel mais recommandé)
SENTRY_DSN=https://your-key@sentry.io/project-id

# Cache (Redis - optionnel mais améliore les performances)
REDIS_URL=redis://user:password@host:port/0